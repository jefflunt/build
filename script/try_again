#!/usr/bin/env bash
set -e

if [ -z "$1" ]; then
    echo "Usage: script/try_again <task-id>"
    exit 1
fi

TASK_ID=$1

if [ ! -f ".build/build.db" ]; then
    echo "Error: .build/build.db not found."
    exit 1
fi

# Reset the task to todo, assign to Dev (2), and reset approval_attempts
sqlite3 .build/build.db "UPDATE tasks SET status='todo', agent_id=2, approval_attempts=0 WHERE id='$TASK_ID';"

echo "Task $TASK_ID has been reset and kicked back to the Developer."
