            []
        ],
        "x": 300,
        "y": 260,
        "z": "build-orchestrator-tab"
    },
    {
        "finalize": "",
        "func": "var stdout = (msg.payload || '').trim();\nif (stdout === '' || stdout === '{}') {\n    node.status({ fill: 'green', shape: 'ring', text: 'All tasks finished' });\n    flow.set('is_processing', false);\n    return null;\n}\ntry {\n    var task = JSON.parse(stdout);\n    if (!task || !task.id) {\n        node.status({ fill: 'green', shape: 'ring', text: 'All tasks finished' });\n        flow.set('is_processing', false);\n        return null;\n    }\n    msg.task = task;\n    msg.assigneeID = task.agent_id ? parseInt(task.agent_id) : 2;\n    node.status({ fill: 'blue', shape: 'dot', text: 'Task ID: ' + task.id + ' (Assignee: ' + msg.assigneeID + ')' });\n    return msg;\n} catch (e) {\n    node.error('Error parsing task: ' + e.message);\n    flow.set('is_processing', false);\n    return null;\n}",
        "id": "parse-task",
        "initialize": "",
        "libs": [],
        "name": "Parse Task JSON",
        "noerr": 0,
        "outputs": 1,
        "type": "function",
        "wires": [
            [
                "route-task"
            ]
        ],
        "x": 510,
        "y": 260,
        "z": "build-orchestrator-tab"
    },
