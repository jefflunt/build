#!/usr/bin/env bash
set -e

if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: script/comment <task-id> <comment text...>"
    exit 1
fi

TASK_ID=$1
shift
COMMENT="$*"

if [ ! -f ".build/build.db" ]; then
    echo "Error: .build/build.db not found. Are you at the project root?"
    exit 1
fi

# Fetch the current agent_id for the task. If none is found, default to 1 (Owner).
AGENT_ID=$(sqlite3 .build/build.db "SELECT agent_id FROM tasks WHERE id='$TASK_ID';")
if [ -z "$AGENT_ID" ]; then
    AGENT_ID=1
fi

# Insert the comment
sqlite3 .build/build.db "INSERT INTO comments (task_id, agent_id, content) VALUES ('$TASK_ID', $AGENT_ID, '$COMMENT');"

echo "Comment added to task $TASK_ID."
