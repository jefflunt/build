    {
        "finalize": "",
        "func": "var stdout = (msg.payload || '').trim();\nif (stdout !== '') {\n    var roleName = 'Unknown';\n    if (msg.assigneeID === 2) roleName = 'Dev';\n    else if (msg.assigneeID === 3) roleName = 'Tester';\n    else if (msg.assigneeID === 4) roleName = 'Boss';\n    else if (msg.assigneeID === 5) roleName = 'Lead';\n    \n    var commitMsg = 'build: updates for task ' + msg.task.id + ' by ' + roleName;\n    msg.payload = 'git commit -m \"' + commitMsg + '\"';\n    msg.has_changes = true;\n} else {\n    msg.has_changes = false;\n}\nreturn msg;",
        "id": "eval-commit",
