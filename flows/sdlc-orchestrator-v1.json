    {
        "addpay": false,
        "append": "",
        "command": "build task next",
        "id": "get-task",
        "name": "Get Next Task",
        "oldrc": false,
        "timer": "",
        "type": "exec",
        "useSpawn": "false",
        "wires": [
            [
                "parse-task"
            ],
