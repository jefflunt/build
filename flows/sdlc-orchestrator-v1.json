[
    {
        "disabled": false,
        "id": "build-orchestrator-tab",
        "info": "This flow is the central SDLC automation orchestrator, designed as an on-demand, event-triggered Hub-and-Spoke system. It listens on HTTP POST /trigger-build, enforces execution locking, pulls tasks via 'build task next', and routes to the appropriate agent subflow spoke.",
        "label": "Build SDLC Orchestrator",
        "type": "tab"
    },
    {
        "id": "http-trigger",
        "type": "http in",
        "z": "build-orchestrator-tab",
        "name": "HTTP Listener /trigger-build",
        "url": "/trigger-build",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 140,
        "wires": [
            [
                "http-response",
                "check-lock"
            ]
        ]
    },
    {
        "id": "http-response",
        "type": "http response",
        "z": "build-orchestrator-tab",
        "name": "Return 200 OK",
        "statusCode": "200",
        "headers": {},
        "x": 360,
        "y": 80,
        "wires": []
    },
    {
        "id": "check-lock",
        "type": "function",
        "z": "build-orchestrator-tab",
        "name": "Check & Set Lock",
        "func": "if (flow.get('is_processing') === true) {\n    node.status({ fill: 'yellow', shape: 'ring', text: 'Locked (already processing)' });\n    return null;\n}\n\nflow.set('is_processing', true);\nnode.status({ fill: 'blue', shape: 'dot', text: 'Lock acquired' });\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 180,
        "wires": [
            [
                "get-task"
            ]
        ]
    },
    {
        "id": "get-task",
        "type": "exec",
        "z": "build-orchestrator-tab",
        "command": "build task next",
        "addpay": false,
        "append": "",
        "useSpawn": "false",
        "timer": "",
        "oldrc": false,
        "name": "Get Next Task",
        "x": 580,
        "y": 180,
        "wires": [
            [
                "parse-task"
            ],
            [],
            []
        ]
    },
    {
        "id": "parse-task",
        "type": "function",
        "z": "build-orchestrator-tab",
        "name": "Parse Task JSON",
        "func": "var stdout = (msg.payload || '').trim();\nif (stdout === '' || stdout === '{}') {\n    node.status({ fill: 'green', shape: 'ring', text: 'All tasks finished' });\n    flow.set('is_processing', false);\n    return null;\n}\ntry {\n    var task = JSON.parse(stdout);\n    if (!task || !task.id) {\n        node.status({ fill: 'green', shape: 'ring', text: 'All tasks finished' });\n        flow.set('is_processing', false);\n        return null;\n    }\n    msg.task = task;\n    msg.assigneeID = task.agent_id ? parseInt(task.agent_id) : 2;\n    node.status({ fill: 'blue', shape: 'dot', text: 'Task ID: ' + task.id + ' (Assignee: ' + msg.assigneeID + ')' });\n    return msg;\n} catch (e) {\n    node.error('Error parsing task: ' + e.message);\n    flow.set('is_processing', false);\n    return null;\n}",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 180,
        "wires": [
            [
                "route-task"
            ]
        ]
    },
    {
        "id": "route-task",
        "type": "switch",
        "z": "build-orchestrator-tab",
        "name": "Route Task",
        "property": "assigneeID",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "1",
                "vt": "num"
            },
            {
                "t": "eq",
                "v": "2",
                "vt": "num"
            },
            {
                "t": "eq",
                "v": "3",
                "vt": "num"
            },
            {
                "t": "eq",
                "v": "4",
                "vt": "num"
            },
            {
                "t": "eq",
                "v": "5",
                "vt": "num"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 5,
        "x": 990,
        "y": 180,
        "wires": [
            [
                "handle-blocked"
            ],
            [
                "inst:dev"
            ],
            [
                "inst:tester"
            ],
            [
                "inst:boss"
            ],
            [
                "inst:lead-dev"
            ]
        ]
    },
    {
        "id": "handle-blocked",
        "type": "function",
        "z": "build-orchestrator-tab",
        "name": "Handle Blocked Task",
        "func": "node.warn('Workflow blocked by failed task: ' + msg.task.id + '. Waiting for Owner intervention.');\nnode.status({ fill: 'red', shape: 'dot', text: 'Blocked by failed task: ' + msg.task.id });\nflow.set('is_processing', false);\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1220,
        "y": 80,
        "wires": [
            []
        ]
    },
    {
        "id": "inst:dev",
        "type": "subflow:subflow:dev",
        "z": "build-orchestrator-tab",
        "name": "dev Instance",
        "x": 1200,
        "y": 130,
        "wires": [
            [
                "loop-back"
            ]
        ]
    },
    {
        "id": "inst:tester",
        "type": "subflow:subflow:tester",
        "z": "build-orchestrator-tab",
        "name": "tester Instance",
        "x": 1200,
        "y": 180,
        "wires": [
            [
                "loop-back"
            ]
        ]
    },
    {
        "id": "inst:boss",
        "type": "subflow:subflow:boss",
        "z": "build-orchestrator-tab",
        "name": "boss Instance",
        "x": 1200,
        "y": 230,
        "wires": [
            [
                "loop-back"
            ]
        ]
    },
    {
        "id": "inst:lead-dev",
        "type": "subflow:subflow:lead-dev",
        "z": "build-orchestrator-tab",
        "name": "lead-dev Instance",
        "x": 1200,
        "y": 280,
        "wires": [
            [
                "loop-back"
            ]
        ]
    },
    {
        "id": "loop-back",
        "type": "function",
        "z": "build-orchestrator-tab",
        "name": "Loop Back",
        "func": "return msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1390,
        "y": 180,
        "wires": [
            [
                "get-task"
            ]
        ]
    }
]
